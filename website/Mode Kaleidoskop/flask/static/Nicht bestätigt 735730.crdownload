<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>kleid_____oskop</title>
    <link rel="stylesheet"
          href="{{ url_for('static', filename='style.css') }}">

    <!-- Layout-Ergänzungen zur vorhandenen static/style.css -->
    <style>
        .hero {
            display: grid;
            grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
            align-items: center;
            gap: clamp(24px, 4vw, 64px);
        }
        .hero-content { min-width: 0; }
        .hero-art {
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 0;
        }
        .hero-art img {
            display: block;
            width: 100%;
            max-width: none;
            height: auto;
            object-fit: contain;
        }
        .features-section .features-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 24px;
            align-items: stretch;
        }
        .features-grid .feature-card-link {
            display: flex;
            min-width: 0;
            color: inherit;
            text-decoration: none;
        }
        .features-grid .feature-card {
            box-sizing: border-box;
            width: 100%;
            height: 100%;
            min-width: 0;
        }
        .feature-card .perspective-image {
            display: block;
            width: 56px;
            height: 56px;
            margin: 0 0 20px;
            object-fit: contain;
        }
        @media (max-width: 1000px) {
            .features-section .features-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }
        @media (max-width: 600px) {
            .hero { grid-template-columns: minmax(0, 1fr); }
            .hero-art img { width: 100%; max-width: none; height: auto; }
            .features-section .features-grid {
                grid-template-columns: minmax(0, 1fr);
            }
        }
    </style>

</head>
<body>
    <!-- HEADER -->
    <header class="header">
        <a href="/" class="logo" aria-label="Kleid-oskop Startseite">
            kleid<span class="logo-line"></span>oskop
        </a>
        <nav class="navigation" aria-label="Hauptnavigation">
            <!-- FEATURE DROPDOWN -->
            <div class="feature-dropdown">
                <button
                    class="feature-button"
                    type="button"
                    aria-expanded="false"
                    aria-controls="feature-menu">
                    Feature
                    <span class="dropdown-arrow">⌄</span>
                </button>
                <div class="feature-menu" id="feature-menu">
                    <a href="/sammlung?kategorie=farbe">Farbe</a>
                    <a href="/sammlung?kategorie=silhouette">Silhouette</a>
                    <a href="/sammlung?kategorie=accessoires">Accessoires</a>
                    <a href="/sammlung?kategorie=embedding">Embedding</a>
                </div>
            </div>
            <a href="#about">About</a>
        </nav>
    </header>
    <main>
        <!-- HERO / STARTSEITE -->
        <section class="hero" id="startseite">
            <div class="hero-content">
            <p class="eyebrow">
                DIGITALE
                <span class="highlight">MODESAMMLUNG</span>
            </p>
            <h1>Mode Kaleidoskop</h1>
            <h2>
                Historische Mode
                <span class="italic">entdecken.</span>
            </h2>
            <p class="description">
                Entdecke die Geschichte der Mode aus
                unterschiedlichen Perspektiven.
                Folge Farben, Formen und visuellen
                Verbindungen durch die Sammlung.
            </p>
           <a href="/sammlung?kategorie=random" class="button">
                Sammlung entdecken ↗
            </a>
            </div>
            <div class="hero-art" aria-hidden="true">
                <img src="{{ url_for('static', filename='dame_im_kleid.png') }}" alt="" decoding="async">
            </div>
        </section>
        <!-- FEATURE ÜBERSICHT -->
        <section class="features-section" id="features">
            <p class="eyebrow">
                ENTDECKE DIE FEATURES
            </p>
            <h2>
                Ein Kaleidoskop.
                <span class="italic">Vier Perspektiven.</span>
            </h2>
            <p class="section-description">
                Wähle ein Merkmal und entdecke
                historische Modebilder auf neue Weise.
            </p>
            <div class="features-grid">
                <!-- FARBE -->
                <a href="/sammlung?kategorie=farbe" class="feature-card-link">
                <article class="feature-card" id="farbe">
                    <img class="perspective-image" src="{{ url_for('static', filename='Farbe.png') }}" alt="" loading="lazy">
                    <h3>Farbe</h3>
                    <p>
                        Entdecke historische Modebilder
                        durch Farben und Farbpaletten.
                        Eine Abbildung kann mehrere
                        Farben enthalten.
                    </p>
                </article>
                </a>
                <!-- SILHOUETTE -->
                <a href="/sammlung?kategorie=silhouette" class="feature-card-link">
                <article class="feature-card" id="silhouette">
                    <img class="perspective-image" src="{{ url_for('static', filename='Sihouette.png') }}" alt="" loading="lazy">
                    <h3>Silhouette</h3>
                    <p>
                        Entdecke Mode durch ihre Formen,
                        Schnitte und charakteristischen
                        Silhouetten.
                    </p>
                </article>
                </a>
                <!-- ACCESSOIRES -->
                <a href="/sammlung?kategorie=accessoires" class="feature-card-link">
                <article class="feature-card" id="accessoires">
                    <img class="perspective-image" src="{{ url_for('static', filename='Accessories.png') }}" alt="" loading="lazy">
                    <h3>Accessoires</h3>
                    <p>
                        Entdecke Hüte, Taschen,
                        Schmuck und weitere modische
                        Accessoires in historischen Bildern.
                    </p>
                </article>
                </a>
                <!-- EMBEDDING -->
                <a href="/sammlung?kategorie=embedding" class="feature-card-link">
                <article class="feature-card" id="embedding">
                    <img class="perspective-image" src="{{ url_for('static', filename='Embedding.png') }}" alt="" loading="lazy">
                    <h3>Embedding</h3>
                    <p>
                        Entdecke visuell verwandte
                        Modebilder. Für jedes erfasste
                        Bild können bis zu fünf ähnliche
                        Bilder angezeigt werden.
                    </p>
                </article>
                </a>
            </div>
        </section>
        <!-- MENÜ / INFORMATION -->
        <section class="info-section" id="about">
            <p class="eyebrow">ÜBER DAS PROJEKT</p>
            <h2>
                Mode aus neuen
                <span class="italic">Blickwinkeln.</span>
            </h2>
            <p class="section-description">
                Das <span class="highlight">kleid____oskop</span> ist ein im Rahmen des Hackathons "Hack the Pool 2026" entstandenes Projekt. Vom 27. - 28. Oktober 2026 arbeiteten daran: Violetta Binz¹, Naemi Bürger¹, Helene Christ², Yongshi "Esther" Chen¹³, Rebecca Daniel¹, Nele Mantaj¹, Bianca Ottenberg¹ & Carina Zander¹.
            <br/>¹Universität Trier ²Universität Wien ³ 
            </p>
            <a href="/" class="button">
                Zurück nach oben ↑
            </a>
        </section>
    </main>
    <footer class="footer">
        <span>kleid____oskop</span>
        <span>Historische Mode × Digital Humanities</span>
    </footer>
    <!-- DROPDOWN INTERACTION -->
    <script>
        const featureButton =
            document.querySelector(".feature-button");
        const featureDropdown =
            document.querySelector(".feature-dropdown");
        const featureMenu =
            document.querySelector(".feature-menu");
        featureButton.addEventListener("click", function () {
            const isOpen =
                featureDropdown.classList.toggle("open");
            featureButton.setAttribute(
                "aria-expanded",
                String(isOpen)
            );
        });
        featureMenu.querySelectorAll("a").forEach(function (link) {
            link.addEventListener("click", function () {
                featureDropdown.classList.remove("open");
                featureButton.setAttribute(
                    "aria-expanded",
                    "false"
                );
            });
        });
        document.addEventListener("click", function (event) {
            if (!featureDropdown.contains(event.target)) {
                featureDropdown.classList.remove("open");
                featureButton.setAttribute(
                    "aria-expanded",
                    "false"
                );
            }
        });
        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                featureDropdown.classList.remove("open");
                featureButton.setAttribute(
                    "aria-expanded",
                    "false"
                );
                featureButton.focus();
            }
        });
async function sammlungClicked(kategorie) {
    console.log("JavaScript gestartet:", kategorie);
    const response = await fetch("/sammlung", {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({
            kategorie: kategorie
        })
    });
    console.log("HTTP-Status:", response.status);
    const result = await response.text();
    console.log("Antwort:", result);
}
    </script>
</body>
</html>
